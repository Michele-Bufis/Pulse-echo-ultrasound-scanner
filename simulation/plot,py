import pandas as pd
import matplotlib.pyplot as plt
import sys
import os

# 1. Percorso del file (fisso)
percorso_file = r"C:\Users\miche\Documents\xxProgetti\LTspiceProgetti\step1_sim_full_nodes.txt"

# Controllo preventivo
if not os.path.exists(percorso_file):
    print(f"\nErrore: Non riesco a trovare il file in '{percorso_file}'.")
    sys.exit()

# 2. Lettura dei dati
try:
    df = pd.read_csv(percorso_file, sep='\s+')
except Exception as e:
    print(f"Errore durante la lettura del file: {e}")
    sys.exit()

colonne = df.columns.tolist()

# 3. Imposta AUTOMATICAMENTE la prima colonna (Tempo) come asse X
col_x = colonne[0]
print(f"\n--- Asse X impostato automaticamente su: [{col_x}] ---")

# 4. Mostra le colonne disponibili per l'asse Y (escludendo la colonna 0)
print("\n--- COLONNE DISPONIBILI PER L'ASSE Y ---")
for i in range(1, len(colonne)):
    print(f"[{i}] {colonne[i]}")

# 5. Scelta delle colonne per l'asse Y
scelta_y_input = input("\nInserisci i numeri delle colonne da visualizzare (separati da virgola, es. 1,3): ")
try:
    indici_y = [int(i.strip()) for i in scelta_y_input.split(',')]
    col_y = [colonne[i] for i in indici_y]
except (ValueError, IndexError):
    print("Errore: Inserimento non valido. Assicurati di inserire i numeri mostrati in elenco.")
    sys.exit()

# 6. Creazione e visualizzazione del grafico
plt.figure(figsize=(10, 6))

for y in col_y:
    plt.plot(df[col_x], df[y], label=y)

# Personalizzazione del grafico
plt.xlabel(col_x)
plt.ylabel("Valore")
plt.title(f"Simulazione LTspice: {', '.join(col_y)}")
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)

# Adatta automaticamente i margini e mostra la finestra
plt.tight_layout()
plt.show()